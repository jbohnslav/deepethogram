ARG DEG_PLATFORM=linux/amd64
FROM --platform=${DEG_PLATFORM} nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MINICONDA_URL=https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh

RUN apt-get update && apt-get install -y --no-install-recommends \
    bzip2 \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    libglib2.0-0 \
    libsm6 \
    libx11-6 \
    libxext6 \
    sudo \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir /app
WORKDIR /app

ENV CONDA_AUTO_UPDATE_CONDA=false \
    PATH=/opt/miniconda/bin:$PATH

RUN curl -fsSL "${MINICONDA_URL}" -o /tmp/miniconda.sh \
    && chmod +x /tmp/miniconda.sh \
    && /tmp/miniconda.sh -b -p /opt/miniconda \
    && rm /tmp/miniconda.sh \
    && conda update -n base -c defaults conda -y

RUN conda install -y python=3.11 \
    && conda clean -afy

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir torch==2.4.1

COPY . /app/deepethogram
WORKDIR /app/deepethogram

ENV DEG_VERSION=headless

RUN pip install --no-cache-dir -e ".[dev]"
